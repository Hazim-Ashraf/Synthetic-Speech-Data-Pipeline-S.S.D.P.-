# ══════════════════════════════════════════════════
# SSDP — Synthetic Speech Data Pipeline .gitignore
# ══════════════════════════════════════════════════

# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ── Virtual Environment ──────────────────────────
.venv/
venv/
env/
ENV/

# ── Logs ─────────────────────────────────────────
logs/
*.log

# # # ── Data / Audio / Output (large files) ──────────
#data/audio/
data/output/
data/manifests/
data/reviewed/

# ── Secrets ───────────────────────────────────────
.env

# ── OS Files ─────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / Editor ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Models (downloaded at runtime) ───────────────
*.gguf
*.nemo
*.bin
*.safetensors
models/

# ── Misc ─────────────────────────────────────────
*.egg-info/
dist/
build/
.eggs/
